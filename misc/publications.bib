	journal = {Nature Communications},
	author = {Zemp, Delphine Clara and Schleussner, Carl-Friedrich and Barbosa, Henrique M. J. and Hirota, Marina and Montade, Vincent and Sampaio, Gilvan and Staal, Arie and Wang-Erlandsson, Lan and Rammig, Anja},
	month = mar,
	year = {2017},
	note = {ERA-Interim},
	pages = {14681},
	file = {Zemp et al. - 2017 - Self-amplified Amazon forest loss due to vegetatio.pdf:C\:\\Users\\rjvanderent\\Zotero\\storage\\TKGJGYAZ\\Zemp et al. - 2017 - Self-amplified Amazon forest loss due to vegetatio.pdf:application/pdf},
}

